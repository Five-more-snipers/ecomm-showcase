# ==============================================================================
# Mock E-Commerce Showcase - Global Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 2. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse / NetBeans
.project
.classpath
.settings/
.nb-gradle/
nbproject/

# Vim / Sublime / Generic
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 3. Frontend (Next.js, Node.js, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/

# Next.js build output & cache
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/

# Turbo cache
.turbo/

# TypeScript build info
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Backend (Java, Maven, Spring Boot)
# ------------------------------------------------------------------------------
# Maven build target
target/
backend/target/
*.class

# Compiled binaries & packages
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper jar download (if generated)
!.mvn/wrapper/maven-wrapper.jar

# Log files
*.log
backend/*.log

# In-memory / persistent database files (H2)
*.mv.db
*.trace.db
backend/*.mv.db
backend/*.trace.db

# ------------------------------------------------------------------------------
# 5. Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
# Ignore real environment secret files
.env
.env*.local
.env.production
.env.development
frontend/.env
frontend/.env*.local

# NEVER ignore the example template
!.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 6. Docker & Persistent Database Mounts
# ------------------------------------------------------------------------------
oracle-data/
oradata/
docker-data/

# ------------------------------------------------------------------------------
# 7. AI Agents / Antigravity / Temporary Scratchpads
# ------------------------------------------------------------------------------
.gemini/
.system_generated/
scratch/
