# ==============================================================================
# Mock E-Commerce Showcase Environment Configuration
# ==============================================================================

# Backend Profile: 'local-h2' (zero external dependency) or 'oracle' (Docker / remote)
SPRING_PROFILES_ACTIVE=local-h2
SERVER_PORT=8080

# Oracle 23c Free Database Config (active when SPRING_PROFILES_ACTIVE=oracle)
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_USERNAME=ecomm_user
DB_PASSWORD=ecomm_password

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
PORT=3000
